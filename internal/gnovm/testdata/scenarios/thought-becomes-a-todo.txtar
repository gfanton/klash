cmd go build ./...
cmd go run . --json main.go | grep -qE '"words": ?[0-9]+'
cmd ! grep -q 'f, _ := os.Open' main.go
cmd go run . /no/such/file; [ $? -ne 0 ]
mem-count open == 0
