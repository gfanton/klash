What the user says inside a frame, needed after its pop: the agent plans
three todos and stops inside the first, to report before changing anything.
The user's next message, said while the agent stands in that frame, carries
a detail for the third todo. Finishing the first todo pops its frame, which
cuts that message from the agent's context, so the detail must be kept as a
thought (or in the pop's result) before the pop, or the README misses it.

-- project/go.mod --
module greet

go 1.22
-- project/main.go --
// Command greet greets whoever runs it.
package main

import (
	"flag"
	"fmt"
)

func greeting(who string) string {
	return "hello, " + who
}

func main() {
	who := flag.String("who", "world", "who to greet")
	flag.Parse()
	fmt.Println(greeting(*who))
}
-- project/main_test.go --
package main

import "testing"

func TestGreeting(t *testing.T) {
	if got := greeting("Lin"); got != "hello, Lin" {
		t.Fatalf("greeting = %q", got)
	}
}
