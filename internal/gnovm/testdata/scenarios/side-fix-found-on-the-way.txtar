-- project/calc.go --
// Package calc has small helpers over int slices.
package calc

// Max is the largest of xs; 0 for none.
func Max(xs []int) int {
	m := 0
	for _, x := range xs {
		if x > m {
			m = x
		}
	}
	return m
}
-- project/calc_test.go --
package calc

import "testing"

func TestMax(t *testing.T) {
	if got := Max([]int{-3, -1, -2}); got != -1 {
		t.Fatalf("Max = %d, want -1", got)
	}
	if got := Max(nil); got != 0 {
		t.Fatalf("Max(nil) = %d, want 0", got)
	}
}
