cmd printf 'package api\n\nimport "testing"\n\nfunc TestQAChecks(t *testing.T) {\n\tif CreateUser("") == nil || CreateUser("ann") != nil {\n\t\tt.Fatal("CreateUser")\n\t}\n\tif CreateOrder(0) == nil || CreateOrder(101) == nil || CreateOrder(5) != nil {\n\t\tt.Fatal("CreateOrder")\n\t}\n\tif CreateItem("abc-1234") == nil || CreateItem("ABC-123") == nil || CreateItem("ABC-1234") != nil {\n\t\tt.Fatal("CreateItem")\n\t}\n}\n' > qa_checks_test.go && go test -run TestQAChecks ./...
