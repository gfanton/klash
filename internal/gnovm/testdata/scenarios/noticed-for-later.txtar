-- project/pager.go --
// Package pager splits n items into pages of per items each.
package pager

// Pages is how many pages n items take at per items a page.
func Pages(n, per int) int {
	return n / per
}

// Offset is the index of the first item on page p, counting pages from 1.
func Offset(p, per int) int {
	return p * per
}
-- project/pager_test.go --
package pager

import "testing"

func TestPages(t *testing.T) {
	for _, c := range []struct{ n, per, want int }{{0, 10, 0}, {10, 10, 1}, {11, 10, 2}, {25, 10, 3}} {
		if got := Pages(c.n, c.per); got != c.want {
			t.Errorf("Pages(%d, %d) = %d, want %d", c.n, c.per, got, c.want)
		}
	}
}
